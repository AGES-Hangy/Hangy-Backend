POSTGRES_DB=hangy
POSTGRES_USER=hangy
POSTGRES_PASSWORD=hangy
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hangy:hangy@db:5432/hangy # muda db pra localhost se tiver rodando local
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
AWS_REGION=us-east-2
S3_BUCKET_NAME=hangy-production-627551519431-us-east-2
# Optional image storage; blank disables uploads without preventing API startup.
AWS_S3_BUCKET=
IMAGE_MAX_SIZE_BYTES=5242880
EXPERIENCE_PHOTO_LIMIT=10 # fotos ativas por usuario por evento; acima disso o POST de foto devolve 409
# AWS_ACCESS_KEY_ID= # optional local credentials, resolved by boto3
# AWS_SECRET_ACCESS_KEY= # optional local credentials, resolved by boto3
# Local: use an authenticated AWS profile or environment credentials.
# On EC2, credentials come from the instance role; do not set static keys.
INVITE_LINK_BASE_URL=hangy://invite/
LOCATION_OBFUSCATION_SECRET=replace_with_another_random_secret # chave do HMAC que desloca o ponto aproximado dos eventos; obrigatoria e diferente do JWT_SECRET_KEY
PRIVATE_EVENT_AREA_RADIUS_M=500 # raio da area mostrada no lugar do pin em evento privado; manter acima de 350
EXPO_ACCESS_TOKEN= # opcional, so se a equipe decidir autenticar as chamadas na Expo
STARTING_SOON_WINDOW_MINUTES=60 # antecedencia (min) do aviso "Evento comecando"
TERMS_VERSION=2026-08-01
TERMS_PUBLISHED_AT=2026-08-01T00:00:00Z
TERMS_URL=https://hangy.app/termos/2026-08-01
TERMS_SUMMARY=Termos de uso e política de privacidade do Hangy.
PROFILE_DESCRIPTION_MAX_LENGTH=500 # limite da bio no PATCH /users/me/profile; provisorio, a confirmar com a equipe (maximo 500 = tamanho da coluna user.description)
